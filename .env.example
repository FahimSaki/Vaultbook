DEPLOY_MODE=portable
DATA_DIR=./.devdata
MIGRATIONS_DIR=./src/server/db/migrations

# Hosted editions only (DEPLOY_MODE=selfhost or cloud)
DATABASE_URL=
MIGRATION_DATABASE_URL=
MASTER_KEY=
BETTER_AUTH_SECRET=
