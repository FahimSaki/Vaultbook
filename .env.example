S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public demo deployment only
DEMO=
CRON_SECRET=
SEED_DATABASE_URL=

# Tests only: a pooled (pgbouncer) URL for tests/pooled.test.ts
POOLED_DATABASE_URL=